# Token bot dari Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Application ID / Client ID dari Discord Developer Portal > General Information
CLIENT_ID=

# ID server Discord (klik kanan nama server > Copy Server ID, aktifkan Developer Mode dulu)
# Opsional tapi disarankan: bikin slash command langsung muncul instan (bukan nunggu ~1 jam)
GUILD_ID=

# ID channel default tempat notifikasi dikirim (klik kanan channel > Copy Channel ID)
# Bisa juga diatur belakangan pakai command /setchannel di dalam Discord
CHANNEL_ID=

# Seberapa sering bot cek feed (dalam menit), default 10
CHECK_INTERVAL_MINUTES=10
